flowchart TD
    D([delivery from Q]) --> X{"bitcode::deserialize::&lt;M&gt;"}
    X -- "Err" --> U["handler.on_undeserializable(...)<br/>default: log error"]
    U -- "Ok(())" --> A1["ack<br/>(dropped, not retried)"]
    U -- "Err(_)" --> N["nack (requeue = false)<br/>enters retry cycle"]
    X -- "Ok" --> H["handler.handle(model, &delivery, retry_count)"]
    H -- "Ok(())" --> A2["ack"]
    H -- "Err(_)" --> M{"with_max_retries(n) set and<br/>retry_count &gt;= n?"}
    M -- "no" --> N
    M -- "yes" --> R["handler.on_retries_exhausted(...)<br/>default: log error"]
    R -- "Ok(())" --> A3["ack<br/>(dropped, retry cycle ends)"]
    R -- "Err(_)" --> N
